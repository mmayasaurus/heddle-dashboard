{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "heddle",
  "version": "0.1.100",
  "identifier": "com.heddle.app",
  "build": {
    "beforeDevCommand": "pnpm build:pocket && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "heddle",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": false,
        "backgroundColor": "#23262b"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Very Good Fiber Goods (VGFG)",
    "copyright": "Copyright (c) 2026 Very Good Fiber Goods (VGFG). Based on VelaTerm, Copyright (c) 2026 VLINX Software (MIT).",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
