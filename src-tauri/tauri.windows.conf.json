{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "resources": [
      "resources/gitbash/**/*"
    ],
    "windows": {
      "nsis": {
        "compression": "zlib",
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": [
          "English",
          "SimpChinese",
          "TradChinese",
          "Japanese",
          "Korean",
          "French",
          "German",
          "Spanish",
          "PortugueseBR",
          "Russian"
        ]
      }
    }
  }
}
